<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link width="" rel="shortcut icon" href="./images/logo-mercado-liebre.jpg" />

	<title> Mercado Liebre Argentina</title>
	<!-- Font Awesome Stylesheet -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2/css/all.min.css">
	<!-- Bootstrap Grid Stylesheet -->
	<link rel="stylesheet" href="/css/bootstrap-grid.min.css">
	<!-- Own Stylesheet -->
	<link rel="stylesheet" href="/css/app.css">
</head>

<body class="searchResultsPage">
	<!-- Header -->
	<% if (usuarioLogueado === undefined) { %>
		<%- include('partials/header') %>
			<% } else { %>
				<%- include('partials/headerLogedin') %>
					<% } %>
						<!-- /Header -->

			

<section class="searchResultsContainer">
		<header class="searchResultsHeader">
			<h1 class="searchResultsTitle">Resultados de búsqueda</h1>
			<p class="searchResultsText">Resultado para: <%= busqueda %></p>
		</header>

		<% if (productos.length > 0) { %>

			<section class="productsList">
				<% for(let i = 0; i < productos.length; i++) { %>

					<article class="productCard">
						<a href="/products/detalle/<%= productos[i].id %>">
							<img
								class="productImage"
								src="/images/products/<%= productos[i].imagenProducto %>"
								alt="<%= productos[i].nombreProducto %>">
						</a>

						<h2 class="productName">
							<a href="/products/detalle/<%= productos[i].id %>">
								<%= productos[i].nombreProducto %>
							</a>
						</h2>

						<p class="productDescription">Descripción: <%= productos[i].descripcionProducto %></p>
						<p class="productDescription">Marca: <%= productos[i].marcaProducto %></p>

						<a class="productLink" href="/products/detalle/<%= productos[i].id %>">Ver detalle</a>
					</article>

				<% } %>
			</section>

		<% } else { %>

			<p class="noproducts">No se encontraron productos.</p>

		<% } %>
	</section>

	

							<!-- footer -->
							<%- include('partials/footer') %>
								<!-- /footer -->
</body>

</html>