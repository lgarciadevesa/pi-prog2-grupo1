<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link width="" rel="shortcut icon" href="./images/logo-mercado-liebre.jpg" />

	<title> Mercado Liebre Argentina</title>
	<!-- Font Awesome Stylesheet -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2/css/all.min.css">
	<!-- Bootstrap Grid Stylesheet -->
	<link rel="stylesheet" href="/css/bootstrap-grid.min.css">
	<!-- Own Stylesheet -->
	<link rel="stylesheet" href="/css/app.css">
</head>

<body>
	<!-- Header -->
	<% if (usuarioLogueado === undefined) { %>
		<%- include('partials/header') %>
	<% } else { %>
		<%- include('partials/headerLogedin') %>
	<% } %>
	<!-- /Header -->

	<!-- Novedades -->
	<div class="container products-wrapper">
		<div class="row">
			<div class="col-12">
				<h2 class="products-title">Editar datos del producto</h2>
			</div>
			<!-- Show the "ultimos" products -->
			<section class="formSection">
							<article class="formContainer">

								<header>
									<h1 class="formTitle">Agregar producto</h1>
								</header>

								<form class="formCustom" action="/products/update/<%= producto.id %>" method="post">

									<article class="formGroup">
										<label class="formLabel" for="image">Imagen</label>
										<input class="formInput" type="text" name="imagen" id="image" value="<%= producto.imagenProducto %>" required>
									</article>

									<article class="formGroup">
										<label class="formLabel" for="productName">Nombre del producto</label>
										<input class="formInput" type="text" name="nombre" id="productName" value="<%= producto.nombreProducto %>"
											required>
									</article>

									<article class="formGroup">
										<label class="formLabel" for="description">Descripción</label>
										<textarea class="formTextarea" name="descripcion" id="description" required> <%= producto.descripcionProducto %> </textarea>
									</article>

									<article class="formGroup">
										<label class="formLabel" for="brand">Marca</label>
										<input class="formInput" type="text" name="marca" id="brand" value="<%= producto.marcaProducto %>"
											required>
									</article>

									<footer>
										<button class="formButton" type="submit">Actualizar</button>
									</footer>

								</form>
							</article>

						</section>



	<!-- footer -->
	<%- include('partials/footer') %>
	<!-- /footer -->
</body>

</html>